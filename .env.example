# Copy to .env.collector.local for the SERVER ONLY. Never use NEXT_PUBLIC_ for secrets.
GITLAB_BASE_URL=
GITLAB_READ_TOKEN=
GITLAB_PROJECT_IDS=
DASHBOARD_WORKSPACE=우리 팀
AWS_REGION=
EKS_CLUSTER_NAME=
# Local: use an AWS IAM Identity Center / SSO profile, not a long-lived access key.
AWS_PROFILE=
# Must explicitly point to the SAME cluster as EKS_CLUSTER_NAME. Never use an implicit current context.
KUBE_CONTEXT=
KUBE_NAMESPACES=
# Match Helm app labels or workload-name components. Change to your actual components.
KUBE_COMPONENTS=webservice,gitaly

# Frontend .env.local ONLY: this is a non-secret, protected API URL.
# For local development: NEXT_PUBLIC_INFRA_STATUS_URL=http://127.0.0.1:4318/api/infra/status
# Production: an HTTPS endpoint behind SSO/VPN, with exact-origin CORS and credentials enabled.
# Leave unset for public GitHub Pages until the access model is approved.

# OPTIONAL separate operations server behind organizational SSO (docs/OPERATIONS-SETUP.md).
# Never put these secrets in the public Pages build environment.
GITLAB_LICENSE_READ_TOKEN=
GITLAB_MAINTENANCE_READ_TOKEN=
GITLAB_MAINTENANCE_WRITE_TOKEN=
LOKI_URL=
LOKI_BEARER_TOKEN=
# Or use Basic auth, never both with Bearer:
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
GRAFANA_URL=
TEMPO_URL=
MIMIR_URL=
OPERATIONS_ALLOWED_ORIGINS=https://majitap.github.io

# Public frontend URL ONLY; leave unset until the protected operations server is ready.
# NEXT_PUBLIC_OPERATIONS_API_URL=https://operations.example.com/api/operations
# NEXT_PUBLIC_DASHBOARD_URL=https://operations.example.com/api/dashboard
